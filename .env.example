# Copy to `.env` (git-ignored) and fill in. Load it before running a pipeline
# script, e.g. `set -a; . ./.env; set +a`.
#
# This file lists the credentials the lesson-deck generation pipeline needs.
# It is not an exhaustive list of every variable the repository reads.

# ElevenLabs, for `scripts/generate-lesson-deck.py`: text-to-speech for every
# narration line, and speech-to-text to transcribe each Thai clip back before
# it is accepted.
#
# It is read from the environment only. It is never a command-line flag, never
# written to a deck, a manifest, a report or a log line, and any vendor error
# text that echoes it back is redacted before it is recorded or printed.
# Generation refuses to start without it rather than quietly producing a deck
# with no audio.
ELEVENLABS_API_KEY=
