# Dependencies
node_modules/

# Build output
dist/

# Test coverage
coverage/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# TypeScript cache
*.tsbuildinfo

# Storage
storage/

# Docker (keep docker-compose.yml but ignore data)
.docker/

# Local development
.pnpm-store/
.worktrees/
scripts/.venv/
backend/.venv/
*/Thai Alphabet/**

# Generated by backend/scripts/run_with_tunnel.sh — the machine-local
# conversation backend auth token, never committed or shipped.
backend/.tunnel-token

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Claude Code local tooling (machine-local, not app source)
.claude/settings.local.json
.claude/agent-memory/
.codegraph/

# Local backup of original lesson videos before re-encoding (not tracked)
video-originals/
# plan-runner: exclude generated worktrees from tools that don't read .git/info/exclude
/.plan-runner-worktrees/

# The lesson-deck pipeline's own environment (qwen-tts pins transformers 4.x,
# which the backend cannot share). The lock file is committed; the venv is not.
scripts/deck-env/.venv/

# The pipeline tests' environment. Same rule: lock committed, venv not.
scripts/tests/.venv/

# Voice-audition samples, generated on demand and never shipped.
public/_samples/

# Fish-Speech S2 Pro spike environment (torch 2.8 pin, conflicts with deck-env).
scripts/fish-env/

# Working copies of lesson scripts, regenerated on demand by
# scripts/lesson-review.py. The lesson itself is the source of truth, and a
# committed copy of it would go stale while still looking authoritative.
review/
