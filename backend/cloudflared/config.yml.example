# Template for a named Cloudflare Tunnel exposing this backend with a
# stable hostname. See "Reaching it from anywhere (Cloudflare Tunnel)" in
# backend/README.md for the full walkthrough this file is one step of.
#
# Requires a domain added to your Cloudflare account as a zone — Cloudflare
# cannot issue a stable public hostname without one. Not needed at all for
# a quick tunnel (`cloudflared tunnel --url http://localhost:8000`), which
# is the zero-setup way to try this before you have a domain.
#
# Usage:
#   1. cloudflared tunnel login
#   2. cloudflared tunnel create conversation-backend
#   3. cloudflared tunnel route dns conversation-backend conversation.yourdomain.com
#   4. Copy this file to ~/.cloudflared/config.yml, fill in the two
#      placeholders below (the tunnel command printed the UUID; the
#      credentials file path is what it wrote to disk), and:
#   5. cloudflared tunnel run conversation-backend

tunnel: <TUNNEL-UUID-FROM-STEP-2>
credentials-file: /home/<you>/.cloudflared/<TUNNEL-UUID-FROM-STEP-2>.json

ingress:
  # Order matters: the first matching hostname wins, and a catch-all
  # (http_status: 404) must be last so an unrecognized hostname reaching
  # this tunnel gets a clean 404 instead of falling through unmatched.
  - hostname: conversation.yourdomain.com
    service: http://localhost:8000
  - service: http_status:404
